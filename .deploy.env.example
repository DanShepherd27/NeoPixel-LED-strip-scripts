# Copy this file to .deploy.env and fill in the values you want to save.
# The actual .deploy.env file is ignored by git and is never copied as app code.
# Use the Pi's LAN IP. A .local hostname requires working mDNS/Bonjour support.
PI_HOST=respberrypi.local
PI_USER=pi
REMOTE_APP_DIR=/home/pi/led-arcade
REMOTE_VENV=/home/pi/neopixel-env

# Website admin secret; if omitted, deploy.py asks for it without echoing.
LED_ARCADE_ADMIN_PASSWORD=

# ALSA capture device; use `arecord -l` on the Pi to identify the microphone.
LED_AUDIO_DEVICE=plughw:CARD=U192k,DEV=0

# Default browser-microphone lease before a queued user is handed the mic.
LED_WEB_MIC_HANDOFF_SECONDS=120

# Additional server secrets may be placed here as LED_ARCADE_* variables.

# ALSA capture device for the phone's Bluetooth stream (sound-reactive Bluetooth source),
# and the speaker delay in milliseconds the lights are held back by.
# LED_BLUETOOTH_AUDIO_DEVICE=bluealsa:PROFILE=a2dp
# LED_BLUETOOTH_LATENCY_MS=300

# ALSA output device for the song show (see `aplay -l`); defaults to LED_AUDIO_DEVICE.
# LED_OUTPUT_AUDIO_DEVICE=plughw:CARD=U192k,DEV=0
