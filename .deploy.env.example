# Copy this file to .deploy.env and fill in the values you want to save.
# The actual .deploy.env file is ignored by git and is never copied as app code.
PI_HOST=raspberrypi.local
PI_USER=pi
REMOTE_APP_DIR=/home/pi/led-arcade
REMOTE_VENV=/home/pi/neopixel-env

# Website admin secret; if omitted, deploy.py asks for it without echoing.
LED_ARCADE_ADMIN_PASSWORD=

# ALSA capture device; use `arecord -l` on the Pi to identify the microphone.
LED_AUDIO_DEVICE=default

# Additional server secrets may be placed here as LED_ARCADE_* variables.
