[Unit]
Description=LED Arcade Bluetooth audio to the Pi speakers
After=bluetooth.service bluealsa.service
Requires=bluealsa.service

[Service]
Type=simple
EnvironmentFile=-/etc/led-arcade.env
# Plays phone audio on the same ALSA output the song show uses ($$ is a literal $ for systemd).
ExecStart=/bin/sh -c 'exec bluealsa-aplay -D "$${LED_OUTPUT_AUDIO_DEVICE:-$${LED_AUDIO_DEVICE:-default}}" --profile-a2dp 00:00:00:00:00:00'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
